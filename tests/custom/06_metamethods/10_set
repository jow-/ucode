The `__set__` metamethod is consulted when a property is assigned which is
not already an own property of the object. It is invoked as a method on the
instance, with the key and the value as arguments.

-- Testcase --
{%
	let log = [];

	let o = proto({ own: 1 }, {
		__set__(key, val) {
			push(log, key + "=" + val);
			rawset(this, "backing:" + key, val);
		}
	});

	o.nw = 2;
	o.own = 3;

	print(rawget(o, "backing:nw"), " ", o.own, "\n");
	print(log, "
");
%}
-- End --

-- Expect stdout --
2 3
[ "nw=2" ]
-- End --

An assignment evaluates to the assigned value, not to whatever the invoked
`__set__` returns.

-- Testcase --
{%
	let o = proto({}, {
		__set__(key, val) {
			rawset(this, key, val * 2);
			return "ignored";
		}
	});

	print((o.x = 21) === 21, " ", o.x, "\n");
%}
-- End --

-- Expect stdout --
true 42
-- End --

Object literals store their members without dispatching `__set__`, including
a metamethod of the very same object.

-- Testcase --
{%
	let o = {
		__set__(key, val) {
			die("intercepted " + key);
		},
		a: 1,
		b: null
	};

	print(o.a, " ", o.b === null, " ", length(keys(o)), "\n");
%}
-- End --

-- Expect stdout --
1 true 3
-- End --

A null value is stored and read back like any other value.

-- Testcase --
{%
	let o = proto({ n: null }, { __get__(key) { return "virtual"; } });

	print(o.n === null, " ");

	o.a = 1;
	o.a = null;
	print(o.a === null, " ", rawget(o, "a") === null, " ");

	rawset(o, "b", null);
	printf("%.J\n", keys(o));
%}
-- End --

-- Expect stdout --
true true true [
	"n",
	"a",
	"b"
]
-- End --

A `__set__` which is itself an object (rather than a function) delegates the
store to that object.

-- Testcase --
{%
	let target = {};
	let o = proto({}, { __set__: target });

	o.x = 42;
	o.y = "hello";

	print(target.x, " ", target.y, "\n");
	print(rawget(o, "x") === null, "\n");
%}
-- End --

-- Expect stdout --
42 hello
true
-- End --

A delegated store re-dispatches the target's own metamethods, so a chain of
delegation reaches the final storage.

-- Testcase --
{%
	let store = {};
	let mid = proto({}, { __set__(key, val) { store[key] = val; } });
	let o = proto({}, { __set__: mid });

	o.n = 7;

	print(store.n, " ", rawget(o, "n") === null, "\n");
%}
-- End --

-- Expect stdout --
7 true
-- End --

Arrays with their own prototype take part in `__set__` delegation for non-index
keys just like objects do.

-- Testcase --
{%
	let target = {};
	let a = proto([10, 20], { __set__: target, __get__: target });

	a[0] = 99;
	a.name = "lan";

	print(a[0], " ", a.name, " ", target.name, "\n");
%}
-- End --

-- Expect stdout --
99 lan lan
-- End --
