19. for...in iteration yields value keys.

-- Testcase --
{%
	let d = dict();
	d["a"] = 1;
	d["b"] = 2;
	d["c"] = 3;
	let collected = [];

	for (let k in d)
		push(collected, k);

	printf("%.J\n", collected);
%}
-- End --

-- Expect stdout --
[
	"a",
	"b",
	"c"
]
-- End --


