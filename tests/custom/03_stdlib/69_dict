12
-- End --


24. Dict GC stress test (no leaks with many dicts and keys).

-- Testcase --
{%
	for (let i = 0; i < 1000; i++) {
		let d = dict();
		for (let j = 0; j < 50; j++) {
			d[j] = j * 2;
			d["k" + j] = "str-" + j;
			d[true] = "bool";
		}
	}

	gc();
	print("ok\n");
%}
-- End --

-- Expect stdout --
ok
-- End --


