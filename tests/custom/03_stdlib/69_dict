11. Delete key from dict.

-- Testcase --
{%
	let d = dict();
	d["a"] = 1;
	d["b"] = 2;
	d["c"] = 3;
	delete d["b"];
	printf("%.J\n", [ length(d), d["a"], d["b"], d["c"] ]);
%}
-- End --

-- Expect stdout --
[
	2,
	1,
	null,
	3
]
-- End --


12. keys() on dict returns actual value keys.

-- Testcase --
{%
	let d = dict();
	d[42] = "x";
	d[true] = "y";
	d["foo"] = "z";
	let k = keys(d);
	printf("%.J\n", [ length(k), type(k[0]), type(k[1]), type(k[2]) ]);
%}
-- End --

-- Expect stdout --
[
	3,
	"int",
	"bool",
	"string"
]
-- End --


