16. Spread dict into object (value keys converted to strings).

-- Testcase --
{%
	let d = dict();
	d[true] = "yes";
	d[42] = "answer";
	d["foo"] = "bar";
	let o = { prefix: 1, ...d, suffix: 2 };
	printf("%.J\n", [
