Closing over local variables in a callback.

-- Testcase --
{%
import * as ffi from 'ffi';

ffi.cdef(`
    void qsort(void *base, size_t nmemb, size_t size,
               int (*compar)(const void *, const void *));
`);

let factor = 10;
let narr = ffi.ctype('int[4]', [30, 10, 20, 40]);
let qsort_fn = ffi.C.wrap('qsort');

let cmp = ffi.closure('int (*)(const void *, const void *)',
                    (a, b) => (a.deref('int') / factor) - (b.deref('int') / factor));
qsort_fn(narr.ptr(), narr.length(), narr.itemsize(), cmp);

print("sorted: ");
for (let i = 0; i < 4; i++) {
    print(narr.get(i), " ");
}
print("\n");
-- End --

-- Expect stdout --
sorted: 10 20 30 40 
-- End --

Multiple closures can coexist independently.

-- Testcase --
{%
import * as ffi from 'ffi';

ffi.cdef(`
    void qsort(void *base, size_t nmemb, size_t size,
               int (*compar)(const void *, const void *));
`);

let qsort_fn = ffi.C.wrap('qsort');
let arr = ffi.ctype('int[4]', [4, 3, 2, 1]);

let asc = ffi.closure('int (*)(const void *, const void *)',
                    (a, b) => a.deref('int') - b.deref('int'));
let desc = ffi.closure('int (*)(const void *, const void *)',
                     (a, b) => b.deref('int') - a.deref('int'));

qsort_fn(arr.ptr(), arr.length(), arr.itemsize(), asc);
print("asc: ");
for (let i = 0; i < 4; i++) {
    print(arr.get(i), " ");
}
print("\n");

qsort_fn(arr.ptr(), arr.length(), arr.itemsize(), desc);
print("desc: ");
for (let i = 0; i < 4; i++) {
    print(arr.get(i), " ");
}
print("\n");
-- End --

-- Expect stdout --
asc: 1 2 3 4 
desc: 4 3 2 1 
-- End --
