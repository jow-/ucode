ffi.closure() creates a C function pointer bound to a ucode function. The
result is an "ffi.closure" resource that can be passed to C functions
expecting function pointers. It supports ptr(), tostring(), and cast() methods.

Create a closure and pass it to qsort.

-- Testcase --
{%
import * as ffi from 'ffi';

ffi.cdef(`
    void qsort(void *base, size_t nmemb, size_t size,
               int (*compar)(const void *, const void *));
`);

let narr = ffi.ctype('int[5]', [56, 4, 12, 1, 5]);
let qsort_fn = ffi.C.wrap('qsort');

let cmp = ffi.closure('int (*)(const void *, const void *)',
                    (a, b) => a.deref('int') - b.deref('int'));
qsort_fn(narr.ptr(), narr.length(), narr.itemsize(), cmp);

print("sorted: ");
for (let i = 0; i < 5; i++) {
    print(narr.get(i), " ");
}
print("\n");
-- End --

-- Expect stdout --
sorted: 1 4 5 12 56 
-- End --

Closure ptr() returns a non-null pointer cdata.

-- Testcase --
{%
import * as ffi from 'ffi';

let cmp = ffi.closure('int (*)(const void *, const void *)',
                    (a, b) => a.deref('int') - b.deref('int'));

let p = cmp.ptr();
print(p != null, "\n");
-- End --

-- Expect stdout --
true
-- End --

Closure tostring() shows the type and address.

-- Testcase --
{%
import * as ffi from 'ffi';

let cmp = ffi.closure('int (*)(const void *, const void *)',
                    (a, b) => a.deref('int') - b.deref('int'));

let s = cmp.tostring();
print(match(s, /^int \(\*\)\(\) 0x/) != null, "\n");
-- End --

-- Expect stdout --
true
-- End --

Closure cast() to the same type returns a cdata.

-- Testcase --
{%
import * as ffi from 'ffi';

let cmp = ffi.closure('int (*)(const void *, const void *)',
                    (a, b) => a.deref('int') - b.deref('int'));

let casted = cmp.cast('int (*)(const void *, const void *)');
print(casted != null, "\n");
print(match(casted.tostring(), /^int \(\*\)\(\) /) != null, "\n");
-- End --

-- Expect stdout --
true
true
-- End --

Pass closure as value for a struct function pointer member.

-- Testcase --
{%
import * as ffi from 'ffi';

ffi.cdef(`
    struct sorter { int (*compare)(const void *, const void *); };
`);

let cmp = ffi.closure('int (*)(const void *, const void *)',
                    (a, b) => a.deref('int') - b.deref('int'));

let s = ffi.ctype('struct sorter');
s.set('compare', cmp);
print("set ok", "\n");
-- End --

-- Expect stdout --
set ok
-- End --

